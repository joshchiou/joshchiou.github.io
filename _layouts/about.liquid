---
layout: default
---
<div class="post">
  <header class="post-header">
    <h1 class="post-title">
      {% if site.title == 'blank' %}
        <span class="font-weight-bold">{{ site.first_name }}</span> {{ site.middle_name }}
        {{ site.last_name }}
      {% else %}
        {{ site.title }}
      {% endif %}
    </h1>
    <p class="desc">{{ page.subtitle }}</p>
  </header>

  <article>
    {% if page.profile %}
      <div class="profile float-{% if page.profile.align == 'left' %}left{% else %}right{% endif %}">
        {% if page.profile.image %}
          {% assign profile_image_path = page.profile.image | prepend: 'assets/img/' %}
          {% if page.profile.image_circular %}
            {% assign profile_image_class = 'img-fluid z-depth-1 rounded-circle' %}
          {% else %}
            {% assign profile_image_class = 'img-fluid z-depth-1
      rounded' %}
          {% endif %}
          {% capture sizes %}(min-width: {{site.max_width}}) {{ site.max_width | minus: 30 | times: 0.3}}px, (min-width: 576px)
      30vw, 95vw"{% endcapture %}
          {%
            include figure.liquid loading="eager" path=profile_image_path class=profile_image_class sizes=sizes alt=page.profile.image_alt
            cache_bust=true
          %}
        {% endif %}
        {% if page.profile.more_info %}
          <div class="more-info">{{ page.profile.more_info }}</div>
        {% endif %}
      </div>
    {% endif %}

    <div class="clearfix">{{ content }}</div>

    <!-- Stats bar + CTA buttons (Option A: stats left, CTAs right) -->
    {% assign stats = site.data.scholar_stats %}
    {% assign pubs = site.data.publication_stats %}
    <div class="about-hero-bar animate-in" style="clear: both;">
      <div class="about-hero-left">
        <div class="about-stats">
          <div class="about-stat">
            <span class="about-stat-num" id="stat-papers">{{ pubs.total }}</span>
            <span class="about-stat-label">publications</span>
          </div>
          <div class="about-stat">
            <span class="about-stat-num" id="stat-citations">{% include commas.liquid n=stats.citations %}</span>
            <span class="about-stat-label">citations</span>
          </div>
          <div class="about-stat">
            <span class="about-stat-num" id="stat-hindex">{{ stats.h_index }}</span>
            <span class="about-stat-label">h-index</span>
          </div>
        </div>
        {% if stats.updated_at %}
          <div class="about-stats-asof">
            Citations and h-index from
            <a href="https://scholar.google.com/citations?user={{ site.scholar_userid }}" target="_blank" rel="noopener">Google Scholar</a>, as of
            {{ stats.updated_at | date: '%b %-d, %Y' }}
          </div>
        {% endif %}
        {% if pubs.top_journals.size > 0 %}
          <div class="about-journals">
            <span class="about-journals-count">{{ pubs.top_journal_papers }} papers in</span>
            {% for journal in pubs.top_journals %}
              <span class="about-journal-pill">{{ journal.name }}</span>
            {% endfor %}
          </div>
        {% endif %}
      </div>
      <div class="about-cta">
        <a href="{{ '/publications/' | relative_url }}" class="about-cta-btn about-cta-primary">
          <i class="fa-solid fa-book-open"></i> Publications
        </a>
        <a href="{{ '/cv/' | relative_url }}" class="about-cta-btn about-cta-secondary"> <i class="ai ai-cv"></i> CV </a>
        <a
          href="{{ '/assets/pdf/CV.pdf' | relative_url }}"
          class="about-cta-link"
          target="_blank"
          rel="noopener"
          aria-label="Download CV as PDF"
          ><i class="fa-solid fa-file-arrow-down"></i> PDF</a
        >
      </div>
    </div>
    <script>
      // Count-up on the stats above. The HTML already holds the real numbers, so crawlers and
      // no-JS visitors read them; the animation only runs for a visible tab, writes nothing until
      // its first frame has advanced, and a timer puts the real number back even if frames stop.
      (function () {
        var els = document.querySelectorAll('#stat-papers, #stat-citations, #stat-hindex');
        var DURATION = 1200;
        var skip =
          document.visibilityState !== 'visible' ||
          window.matchMedia('(prefers-reduced-motion: reduce)').matches ||
          /bot|crawl|spider|slurp|lighthouse|headless/i.test(navigator.userAgent);
        var animated = false;

        function animateCountUp(el) {
          var final = el.textContent;
          var target = parseInt(final.replace(/,/g, ''), 10);
          if (isNaN(target) || target <= 0) return;
          var startTime = null;
          function step(ts) {
            if (startTime === null) startTime = ts;
            var progress = Math.min((ts - startTime) / DURATION, 1);
            if (progress > 0) {
              var eased = 1 - Math.pow(1 - progress, 3);
              el.textContent = progress < 1 ? Math.round(eased * target).toLocaleString('en-US') : final;
            }
            if (progress < 1) requestAnimationFrame(step);
          }
          requestAnimationFrame(step);
          setTimeout(function () {
            el.textContent = final;
          }, DURATION + 200);
        }

        function triggerCountUp() {
          if (animated || skip) return;
          animated = true;
          els.forEach(animateCountUp);
        }

        var bar = document.querySelector('.about-hero-bar');
        if (bar) {
          var observer = new MutationObserver(function (mutations) {
            mutations.forEach(function (m) {
              if (m.target.classList.contains('visible')) {
                triggerCountUp();
                observer.disconnect();
              }
            });
          });
          observer.observe(bar, { attributes: true, attributeFilter: ['class'] });
          if (bar.classList.contains('visible')) triggerCountUp();
        }
      })();
    </script>

    <!-- Research themes -->
    <div class="animate-in">{% include research_themes.liquid %}</div>

    <!-- Selected papers -->
    {% if page.selected_papers %}
      <div class="animate-in">
        <h2 class="about-section-heading mt-4">
          <a href="{{ '/publications/' | relative_url }}" style="color: inherit">selected publications</a>
        </h2>
        {% include selected_papers.liquid %}
      </div>
    {% endif %}

    <!-- News -->
    {% if page.news and site.announcements.enabled %}
      <div class="animate-in">
        <h2 class="about-section-heading">
          <a href="{{ '/news/' | relative_url }}" style="color: inherit">news</a>
        </h2>
        {% include news.liquid limit=true %}
      </div>
    {% endif %}

    <!-- Social -->
    {% if page.social %}
      <div class="social">
        <div class="contact-icons">{% include social.liquid %}</div>

        <div class="contact-note">{{ site.contact_note }}</div>
      </div>
    {% endif %}

    {% if site.newsletter.enabled and site.footer_fixed %}
      {% include scripts/newsletter.liquid center=true %}
    {% endif %}
  </article>
</div>
